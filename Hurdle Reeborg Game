def turn_right():
    turn_left()
    turn_left()
    turn_left()


while not at_goal():
    if not front_is_clear():
        turn_left()
        move()
        turn_right()
        move()
        turn_right()
        move()
        turn_left()

    else:
        move()

# Solution for Hurdle 4

def turn_right():
    turn_left()
    turn_left()
    turn_left()

while not at_goal():
    if right_is_clear():
        turn_right()
        move()
    elif front_is_clear():
        move()
    else:
        turn_left()
